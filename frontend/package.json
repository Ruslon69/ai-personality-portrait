{
  "name": "ai-personality-portrait-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --check .",
    "quality:bundle": "vite build --ssr src/quality-gates/index.ts --outDir node_modules/.tmp/quality-gates --emptyOutDir",
    "quality": "npm run quality:bundle && node node_modules/.tmp/quality-gates/index.js",
    "quality:domain": "npm run quality:bundle && node node_modules/.tmp/quality-gates/index.js --tag=domain",
    "quality:storage": "npm run quality:bundle && node node_modules/.tmp/quality-gates/index.js --tag=storage",
    "quality:architecture": "npm run quality:bundle && node node_modules/.tmp/quality-gates/index.js --tag=architecture",
    "quality:fast": "npm run quality:bundle && node node_modules/.tmp/quality-gates/index.js --tag=fast"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
